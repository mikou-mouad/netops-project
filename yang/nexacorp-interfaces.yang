module nexacorp-interfaces {
  namespace "urn:nexacorp:interfaces";
  prefix nci;
  list site {
    key "name";
    leaf name {
      type string;
    }
    list interface {
      key "name";
      leaf name {
        type string;
      }
      leaf description {
        type string;
      }
      leaf enabled {
        type enumeration {
          enum up;
          enum down;
        }
      }
      leaf vlan-id {
        type uint16 {
          range "1..4094";
        }
      }
    }
  }
}
